# SLAF TTS Management Portal Configuration Example

# Environment Configuration
ENVIRONMENT=development
PORT=8000

# Database Configuration
# Supported DB_ENGINE values: mysql, sqlite
DB_ENGINE=sqlite
DB_FILE=./database.db

# For Production (MySQL)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=slaf_admin
MYSQL_PASSWORD=SlafAdminSecretPass123!
MYSQL_DATABASE=slaf_tts_db
MYSQL_ROOT_PASSWORD=SlafRootSecretPass123!

# JWT Configuration
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=45c4779fe379d71c89f5bc3a6c2f0f4a86161474ea595d73bb851d7cf9d2c180
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Setup Seed Credentials (will be created automatically on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@slaf.lk
